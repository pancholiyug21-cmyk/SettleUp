rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isGroupMember(groupId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    
    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }
    
    // Groups
    match /groups/{groupId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      // Anyone can create a group, but the Cloud Function handles joining.
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      
      // Members subcollection
      match /members/{memberId} {
        // Only members of the group can see the member list
        allow read: if isGroupMember(groupId);
        // Clients CANNOT directly write to the members collection.
        // Group joining and creator-owner assignment must happen via Cloud Functions.
        allow create, update, delete: if false;
      }
    }
    
    // Expenses
    match /expenses/{expenseId} {
      allow read, write: if isAuthenticated() && (
        // Allow creating/reading expenses only if the user is a member of the target group
        // If it's a new expense, we check the requested groupId
        // If it's an existing expense, we check the stored groupId
        isGroupMember(request.resource.data.groupId) || 
        isGroupMember(resource.data.groupId)
      );
    }
    
    // Expense Splits (Client-side writes to splits should be tied to expense operations, but for now we restrict to authenticated users)
    match /expenseSplits/{splitId} {
      // Ideal scenario would check if the split belongs to an expense in a group the user is in.
      allow read, write: if isAuthenticated(); // To be tightened if splits store groupId
    }
    
    // Payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.payerId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.payerId == request.auth.uid;
      allow update: if isAuthenticated() && 
        (resource.data.payerId == request.auth.uid || resource.data.receiverId == request.auth.uid) &&
        request.resource.data.status == resource.data.status;
    }
    
    // Settlements
    match /settlements/{settlementId} {
      allow read: if isAuthenticated() && (
        resource.data.payerId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow create, update: if false; 
    }
  }
}
